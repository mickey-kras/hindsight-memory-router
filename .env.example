# Port the memory router listens on.
MEMORY_ROUTER_PORT=8890
# Bearer token required for retain/recall/version. When unset the router
# fails closed (401 for every request).
MEMORY_ROUTER_TOKEN=change-me
# Least-privilege admin tokens. Review can also read; cleanup is cleanup-only.
MEMORY_ROUTER_ADMIN_READ_TOKEN=change-me-admin-read-token
MEMORY_ROUTER_ADMIN_REVIEW_TOKEN=change-me-admin-review-token
MEMORY_ROUTER_ADMIN_CLEANUP_TOKEN=change-me-admin-cleanup-token
# Legacy migration superuser for every /admin/* route. Prefer leaving unset.
MEMORY_ROUTER_ADMIN_TOKEN=
# Development-only escape hatch: allow anonymous retain/recall/version access
# when MEMORY_ROUTER_TOKEN is unset. Never enable outside local development.
MEMORY_ROUTER_ALLOW_ANONYMOUS=false
# Per-process admin rate limits (429 admin_rate_limited when exceeded).
MEMORY_ROUTER_ADMIN_RATE_LIMIT_READ_MAX=120
MEMORY_ROUTER_ADMIN_RATE_LIMIT_WRITE_MAX=30
MEMORY_ROUTER_ADMIN_RATE_LIMIT_WINDOW_MS=60000
# Maximum JSON request body size in bytes.
MEMORY_ROUTER_MAX_BODY_BYTES=1048576
# Upstream Hindsight API.
HINDSIGHT_BASE_URL=http://hindsight:8888
HINDSIGHT_API_KEY=change-me
# Upstream Hindsight request timeout in milliseconds.
HINDSIGHT_TIMEOUT_MS=10000
# Writer registry JSON file.
MEMORY_ROUTER_REGISTRY=/app/writer_registry.example.json
# RSA public key (PEM or base64 PEM) used to encrypt quarantined payloads.
# The matching QUARANTINE_PRIVATE_KEY must never be set on the router process.
QUARANTINE_PUBLIC_KEY=
# Quarantine database. sqlite:<path> or postgres(ql)://user:pass@host:5432/db.
QUARANTINE_DATABASE_URL=sqlite:./data/quarantine.db
# Maximum times an item can be postponed before it must be resolved.
QUARANTINE_MAX_POSTPONES=3
# Quarantine capacity and store rate limits (non-negative integers).
QUARANTINE_MAX_ITEM_BYTES=1048576
QUARANTINE_MAX_PENDING_ITEMS=1000
# Must leave global item and byte capacity for other writers.
QUARANTINE_MAX_PENDING_ITEMS_PER_WRITER=50
QUARANTINE_MAX_ENCRYPTED_BYTES=104857600
QUARANTINE_RATE_LIMIT_MAX=30
QUARANTINE_RATE_LIMIT_GLOBAL_MAX=300
# Distinct normalized/structural request families admitted per writer scope/window.
QUARANTINE_DISTINCT_FAMILY_LIMIT_MAX=10
QUARANTINE_REQUARANTINE_OPS_MAX=1000
QUARANTINE_RATE_LIMIT_WINDOW_MS=60000
# Retention: quarantine item TTL and sweep cadence (0 disables).
QUARANTINE_ITEM_TTL_DAYS=30
QUARANTINE_SWEEP_INTERVAL_SECONDS=3600
QUARANTINE_EVENT_RETENTION_DAYS=90
