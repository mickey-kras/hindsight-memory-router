# Memory Router environment reference.
# Tuning/deployment values use built-in defaults when absent.
# QUARANTINE_PUBLIC_KEY is required and has no default.

# Listener and deployment.
# MEMORY_ROUTER_PORT=8890
# MEMORY_ROUTER_DEPLOYMENT_MODE=single
# MEMORY_ROUTER_EXTERNAL_ADMIN_RATE_LIMIT=false

# Router/admin authentication. No shared default credentials are provided.
# When router/admin tokens are absent, the corresponding endpoints fail closed.
# MEMORY_ROUTER_TOKEN=<generate-a-secret>
# MEMORY_ROUTER_ADMIN_READ_TOKEN=<generate-a-separate-secret>
# MEMORY_ROUTER_ADMIN_REVIEW_TOKEN=<generate-a-separate-secret>
# MEMORY_ROUTER_ADMIN_CLEANUP_TOKEN=<generate-a-separate-secret>
# MEMORY_ROUTER_ADMIN_TOKEN=
# MEMORY_ROUTER_ALLOW_ANONYMOUS=false

# Authentication failure throttling.
# MEMORY_ROUTER_AUTH_FAILURE_RATE_LIMIT_MAX=120
# MEMORY_ROUTER_AUTH_FAILURE_RATE_LIMIT_WINDOW_MS=60000

# Admin rate limits.
# MEMORY_ROUTER_ADMIN_RATE_LIMIT_READ_MAX=120
# MEMORY_ROUTER_ADMIN_RATE_LIMIT_WRITE_MAX=30
# MEMORY_ROUTER_ADMIN_RATE_LIMIT_WINDOW_MS=60000
# MEMORY_ROUTER_MAX_BODY_BYTES=1048576

# Supported memory provider: Hindsight.
# HINDSIGHT_BASE_URL=http://hindsight:8888
# HINDSIGHT_API_KEY=<provider-api-key>
# HINDSIGHT_TIMEOUT_MS=10000
# HINDSIGHT_RETAIN_RATE_LIMIT_WRITER_MAX=30
# HINDSIGHT_RETAIN_RATE_LIMIT_GLOBAL_MAX=300
# HINDSIGHT_RECALL_RATE_LIMIT_WRITER_MAX=120
# HINDSIGHT_RECALL_RATE_LIMIT_GLOBAL_MAX=1200
# HINDSIGHT_RATE_LIMIT_WINDOW_MS=60000
# HINDSIGHT_RETAIN_MAX_ITEMS=100
# HINDSIGHT_RETAIN_MAX_CONTENT_BYTES=524288
# HINDSIGHT_RECALL_MAX_QUERY_BYTES=32768
# HINDSIGHT_RECALL_MAX_TOKENS=8192
# HINDSIGHT_MAX_RESPONSE_BYTES=4194304

# Optional writer registry override. The built-in registry provides one neutral
# writer named "main" that reads/writes the "main" bank. The bundled example
# preserves the historical richer six-writer topology for compatibility.
# MEMORY_ROUTER_REGISTRY=/app/writer_registry.example.json

# Per-agent principal mode. Setting this replaces the shared router token:
# MEMORY_ROUTER_TOKEN and MEMORY_ROUTER_ALLOW_ANONYMOUS=true are rejected at
# startup. Tokens are mr_<key-id>_<256-bit-secret-hex>; the registry stores
# SHA-256 digests of secrets only, plus per-key created_at and optional
# expires_at/revoked_at ISO 8601 timestamps for rotation and revocation.
# Generate with:
#   secret=$(openssl rand -hex 32); printf '%s' "$secret" | sha256sum
# MEMORY_ROUTER_PRINCIPALS=/app/principal_registry.example.json
# Per-principal request, rate, and concurrency limits:
# MEMORY_ROUTER_PRINCIPAL_RATE_LIMIT_MAX=240
# MEMORY_ROUTER_PRINCIPAL_RATE_LIMIT_WINDOW_MS=60000
# MEMORY_ROUTER_PRINCIPAL_CONCURRENCY_MAX=8

# Required quarantine encryption key; no built-in default.
# Generate the keypair on a trusted admin machine. Store the private key there.
# For .env/Compose, provide only the public key as base64-encoded PEM. Raw
# multi-line PEM is supported only when injected directly into a non-Compose
# process environment; dotenv parsing cannot safely preserve it.
# Never provide a QUARANTINE_PRIVATE_KEY* variable to the router process or host.
# QUARANTINE_PUBLIC_KEY=<base64-public-key-pem>

# Quarantine storage and policy limits.
# QUARANTINE_DATABASE_URL=sqlite:./data/quarantine.db
# QUARANTINE_MAX_POSTPONES=3
# QUARANTINE_MAX_ITEM_BYTES=1048576
# QUARANTINE_MAX_PENDING_ITEMS=1000
# QUARANTINE_MAX_PENDING_ITEMS_PER_WRITER=50
# QUARANTINE_MAX_ENCRYPTED_BYTES=104857600
# QUARANTINE_RATE_LIMIT_MAX=30
# QUARANTINE_RATE_LIMIT_GLOBAL_MAX=300
# QUARANTINE_DISTINCT_FAMILY_LIMIT_MAX=10
# QUARANTINE_REQUARANTINE_OPS_MAX=1000
# QUARANTINE_RATE_LIMIT_WINDOW_MS=60000
# QUARANTINE_ITEM_TTL_DAYS=30
# QUARANTINE_SWEEP_INTERVAL_SECONDS=3600
# QUARANTINE_EVENT_RETENTION_DAYS=90
