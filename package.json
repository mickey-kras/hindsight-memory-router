{
  "name": "hindsight-memory-router",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate:legacy-quarantine": "node dist/src/cli/migrateLegacyQuarantine.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi:auth:sync": "node scripts/updateOpenApiAdminAuth.mjs",
    "openapi:lint": "redocly lint openapi/openapi.json --config redocly.yaml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "aislop:ci": "npx --yes aislop@latest ci --changes --base origin/main",
    "aislop:fix:safe": "npx --yes aislop@latest fix --safe",
    "check": "npm run format:check && npm run lint && npm run openapi:lint && npm run test:coverage && npm run typecheck && npm run security:audit && npm run aislop:ci",
    "fix": "npm run openapi:auth:sync && npm run format && npm run lint:fix && npm run aislop:fix:safe",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.41.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
