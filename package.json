{
  "name": "hindsight-memory-router",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "openapi:lint": "redocly lint openapi/openapi.json openapi/openclaw.json --config redocly.yaml",
    "security:audit": "npm audit --audit-level=moderate",
    "aislop:ci": "aislop ci --changes --base origin/main",
    "aislop:ci:human": "aislop ci --human",
    "aislop:ci:sarif": "aislop ci --sarif",
    "aislop:fix:safe": "aislop fix --safe",
    "check": "npm run openapi:lint && npm run security:audit && npm run aislop:ci",
    "fix": "npm run aislop:fix:safe",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1",
    "aislop": "0.14.1"
  },
  "overrides": {
    "postcss": {
      "nanoid": "5.1.16"
    }
  }
}
