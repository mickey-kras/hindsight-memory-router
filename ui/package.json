{
  "name": "memory-router-ui",
  "version": "0.2.0",
  "description": "Quarantine review console for hindsight-memory-router. Static SPA; decrypts locally, never in the router.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepack": "npm run build",
    "fixtures": "python3 tests/gen_fixtures.py",
    "fixtures:clean": "python3 tests/gen_fixtures.py --clean",
    "pretest": "npm run fixtures",
    "test": "vitest run",
    "posttest": "npm run fixtures:clean",
    "pretest:e2e": "npm run fixtures",
    "test:e2e": "playwright test",
    "posttest:e2e": "npm run fixtures:clean",
    "test:package": "node tests/package-consumer.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^7.0.4",
    "vitest": "^5.0.1"
  }
}
