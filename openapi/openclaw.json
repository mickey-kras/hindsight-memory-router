    "/v1/default/banks/{bank_id}/directives": {
      "get": {
        "summary": "List directives in the resolved bank",
        "operationId": "hindsightGetDirectives",
        "security": [
          {
            "RouterToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BankId"
          },
          {
            "description": "Filter directives by execution scope. Omit or pass [] to list all directives.",
            "explode": true,
            "in": "query",
            "name": "tags",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "description": "How tagged directives match the requested scope. Untagged/global directives are included.",
            "explode": true,
            "in": "query",
            "name": "tags_match",
            "required": false,
            "schema": {
              "default": "any",
              "description": "How tagged directives match the requested scope. Untagged/global directives are included.",
              "enum": [
                "any",
                "all",
                "exact"
              ],
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Only return active directives",
            "explode": true,
            "in": "query",
            "name": "active_only",
            "required": false,
            "schema": {
              "default": true,
              "description": "Only return active directives",
              "type": "boolean"
            },
            "style": "form"
          },
          {
            "explode": true,
